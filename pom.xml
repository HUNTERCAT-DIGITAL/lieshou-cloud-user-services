<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    user-services 聚合构建（单一模块）：
    services/user
    上游 framework 不再随仓（无 submodule）—— `framework-parent` / `framework-*`
    统一从内网 Nexus 解析（https://nexus.ts.huntercat.cn/repository/maven-public/）。
    一次构建：mvn -f pom.xml package
  -->
  <groupId>cn.huntercat</groupId>
  <artifactId>lieshoucloud-user-services-aggregator</artifactId>
  <!-- 聚合器自身坐标：不发布、不被任何模块作为 parent 引用，故与 framework 版本线解耦。
       服务模块的版本来自 framework-parent（当前 0.3.3）。 -->
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>user-services</name>

  <modules>
    <module>services/user</module>
  </modules>
</project>
