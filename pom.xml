<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    user-services 聚合构建（submodule 引用模式，同 lieshou-boot）：
    framework（→ lieshou-framework submodule，含统一 parent framework-parent）
      + services/user
    一次构建：mvn -f pom.xml package
    说明：framework-* 依赖在 reactor 内解析，无需先 install；
          缺 framework submodule 时，需先从 lieshou-framework 发版（0.3.0）装到本地仓。
  -->
  <groupId>cn.huntercat</groupId>
  <artifactId>lieshoucloud-user-services-aggregator</artifactId>
  <!-- 聚合器自身坐标：不发布、不被任何模块作为 parent 引用，故与 framework 版本线解耦。
       服务模块的版本来自 framework-parent（当前 0.3.0）。 -->
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>user-services</name>

  <modules>
    <module>framework</module>
    <module>services/user</module>
  </modules>
</project>
